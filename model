# Step 1: Submit video generation request
curl https://openrouter.ai/api/v1/videos \-H "Content-Type: application/json" \-H "Authorization: Bearer $OPENROUTER_API_KEY" \-d '{
    "model": "minimax/hailuo-3-max",
    "prompt": "A serene mountain landscape at sunset with clouds drifting by"
  }'

# Response includes a polling_url. Use it to check status:
# curl <polling_url> -H "Authorization: Bearer $OPENROUTER_API_KEY"
