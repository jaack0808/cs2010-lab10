# Copy the values you need into openrouter.env (gitignored) or .env.
# The server loads openrouter.env first, then .env.

# Required: your OpenRouter key.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides.
# Image model used for the text+image-to-image repaint.
IMAGE_MODEL=qwen/qwen-image-2.1-turbo
# weather.gov requires a User-Agent with contact info.
WEATHER_USER_AGENT=cs2010-lab10-weather-app (you@example.com)
# Location to pull weather for (defaults to Plymouth, NH).
WEATHER_LAT=43.7589
WEATHER_LON=-71.6892
# Reference image that gets repainted.
REFERENCE_IMAGE=public/reference.png
